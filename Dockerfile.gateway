FROM node:18-alpine AS base

RUN apk add --no-cache libc6-compat curl
WORKDIR /app

COPY package*.json ./
COPY nx.json ./
COPY tsconfig.base.json ./

FROM base AS deps
RUN npm ci --only=production && npm cache clean --force

FROM base AS builder
RUN npm ci

COPY . .

# Генерируем protobuf типы и Prisma client
RUN npm run proto:all
RUN npm run prisma:generate

# Собираем API Gateway
RUN npm run build:gateway

FROM node:18-alpine AS runner
WORKDIR /app

# Устанавливаем curl для health checks
RUN apk add --no-cache curl

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nestjs

# Копируем только API Gateway
COPY --from=builder --chown=nestjs:nodejs /app/dist/apps/api-gateway ./
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/package*.json ./
COPY --from=builder --chown=nestjs:nodejs /app/prisma ./prisma

USER nestjs

# API Gateway использует стандартный порт Railway
EXPOSE $PORT

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:$PORT/health || exit 1

CMD ["node", "main.js"]
