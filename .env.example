# Environment Configuration
NODE_ENV=development
PORT=3000

# HTTPS Configuration
ENABLE_HTTPS=false
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# Logging
LOG_LEVEL=info

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/decorify_db"
TEST_DATABASE_URL="postgresql://username:password@localhost:5432/decorify_test_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRATION=1d

# Redis
REDIS_URL="redis://localhost:6379"

# gRPC Services URLs
AUTH_SERVICE_URL=localhost:50051
PRODUCT_SERVICE_URL=localhost:50052
ORDER_SERVICE_URL=localhost:50053
PAYMENT_SERVICE_URL=localhost:50054
VENDOR_SERVICE_URL=localhost:50055
CART_SERVICE_URL=localhost:50056
CATEGORY_SERVICE_URL=localhost:50057

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Security
HELMET_ENABLED=true
CORS_ENABLED=true

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Microservices URLs
AUTH_SERVICE_URL="localhost:50051"
ORDER_SERVICE_URL="localhost:50052"
PRODUCT_SERVICE_URL="localhost:50053"
PAYMENT_SERVICE_URL="localhost:50054"
VENDOR_SERVICE_URL="localhost:50055"
CART_SERVICE_URL="localhost:50056"

# API Gateway
API_GATEWAY_PORT=3000
